# Copy this file to .env and fill in values locally. .env is ignored by Git.
NEBIUS_API_KEY=

# Optional: leave blank for Keenable's rate-limited public tier.
KEENABLE_API_KEY=

# Exact model ID from your Nebius catalog. Choose a text model tagged JSON mode.
# https://tokenfactory.nebius.com/
NEBIUS_MODEL=

# Optional settings. Existing shell environment variables take priority.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MAX_TOKENS=6000
NEBIUS_TIMEOUT_SECONDS=300

# Node.js executable for local Mermaid SVG/PNG rendering. An absolute path is OK.
NODE_BINARY=node
